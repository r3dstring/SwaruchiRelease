# Neon Postgres connection string (from Neon dashboard → Connection Details)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Your free Groq API key from console.groq.com
GEMINI_API_KEY=gsk_your_groq_key_here

# A long random string — sign JWT tokens. Change this to anything.
JWT_SECRET=change-me-to-a-long-random-string

# The email that should be the admin account
ADMIN_EMAIL=you@example.com

# Your deployed frontend URL (set after Netlify deploy)
FRONTEND_URL=https://your-app.netlify.app
